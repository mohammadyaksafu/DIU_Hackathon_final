{
  "uid": "shurokkha-ops",
  "title": "Shurokkha operations",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"type": "stat", "title": "Requests / s", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum(rate(shurokkha_http_requests_total[1m]))", "refId": "A"}]},
    {"type": "stat", "title": "Scoring p95 (ms)", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "histogram_quantile(0.95, sum(rate(shurokkha_score_latency_ms_bucket[5m])) by (le))", "refId": "A"}]},
    {"type": "stat", "title": "Scams averted (customer cancelled)", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum(shurokkha_scams_averted_total)", "refId": "A"}]},
    {"type": "stat", "title": "Degraded decisions / scoring errors", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum(shurokkha_degraded_decisions_total) or vector(0)", "refId": "A"},
                 {"expr": "sum(shurokkha_scoring_errors_total) or vector(0)", "refId": "B"}]},
    {"type": "timeseries", "title": "Decision mix (per minute)", "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum by (decision) (rate(shurokkha_decisions_total[1m]) * 60)", "legendFormat": "{{decision}}", "refId": "A"}]},
    {"type": "timeseries", "title": "Scoring latency p50 / p95 / p99 (ms)", "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"expr": "histogram_quantile(0.50, sum(rate(shurokkha_score_latency_ms_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
       {"expr": "histogram_quantile(0.95, sum(rate(shurokkha_score_latency_ms_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B"},
       {"expr": "histogram_quantile(0.99, sum(rate(shurokkha_score_latency_ms_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C"}]},
    {"type": "timeseries", "title": "HTTP status codes (per minute)", "gridPos": {"x": 0, "y": 13, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum by (status) (rate(shurokkha_http_requests_total[1m]) * 60)", "legendFormat": "{{status}}", "refId": "A"}]},
    {"type": "timeseries", "title": "Customer actions after a decision", "gridPos": {"x": 12, "y": 13, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum by (action, decision) (shurokkha_customer_actions_total)", "legendFormat": "{{decision}} → {{action}}", "refId": "A"}]}
  ]
}
