# Copy to deploy/.env on the server and fill in. Never commit the real .env.

# Your domain (its DNS A record must point to this VPS)
DOMAIN=shurokkha.example.com
# Email for Let's Encrypt certificate notices
ACME_EMAIL=you@example.com

# Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Password for the demo users customer and analyst.
# NOTE: this is built into the public web bundle (the site signs in automatically),
# so anyone who opens the site can read it. It never unlocks admin in production.
DEMO_PASSWORD=

# Admin password (policy editing, model switching). Never sent to the browser:
# you type it on the Admin page. Leave empty to disable admin changes entirely.
# Generate with:  openssl rand -hex 12
ADMIN_PASSWORD=

# Optional: Gemini is preferred by LLM_PROVIDER=auto when this key is set.
# Create a key in Google AI Studio; free-tier quota and model availability can vary.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional alternative provider
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto

# API worker processes (default 1). Live state is shared in Redis, so 2+ is safe;
# each worker holds its own copy of the model, so check free RAM first (free -m).
API_WORKERS=1

# Optional (step 7): IPs allowed to use /admin, space-separated (IPs or CIDRs), e.g. "203.0.113.7 198.51.100.0/24"
ADMIN_ALLOW_IPS=
