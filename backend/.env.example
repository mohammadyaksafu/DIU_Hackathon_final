# ---- Storage ----
# Empty = SQLite file in ./data. Postgres example: postgresql://user:password@host:5432/shurokkha
DATABASE_URL=
# Optional Redis: cache, shared rate limits, and the online feature state shared by every API worker
# (in-memory fallback when empty or unreachable; then run a single worker)
REDIS_URL=
# auto | memory | redis   (auto = Redis when REDIS_URL is reachable)
FEATURE_STORE=auto

# ---- GenAI (optional; without a key the copilot uses deterministic fallbacks) ----
# auto | gemini | anthropic | none (auto prefers Gemini when GEMINI_API_KEY is set)
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=<your-anthropic-api-key>
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=30

# ---- Security ----
JWT_SECRET=<random-32-byte-string>
DEMO_PASSWORD=<choose-a-demo-password>
# Admin login (policy / model changes). Empty: admin uses DEMO_PASSWORD only when ENVIRONMENT=development.
ADMIN_PASSWORD=
ENVIRONMENT=development
AUTH_REQUIRED=true
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=1200
# Handler threads per API worker (scoring is CPU-bound: more workers beat more threads)
THREADPOOL_SIZE=8
# PostgreSQL connections per worker (the same number again is allowed as overflow)
DB_POOL_SIZE=20

# ---- Model / runtime ----
ACTIVE_MODEL=
SEED_ON_BOOT=true
AUTO_BOOTSTRAP=true
LATENCY_BUDGET_MS=150
GRAPH_REFRESH_SECONDS=600
